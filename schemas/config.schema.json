{
  "$defs": {
    "AsrConfig": {
      "additionalProperties": false,
      "description": "Free speech recognition provider policy.",
      "properties": {
        "dashscope_fallback_models": {
          "default": [
            "fun-asr",
            "fun-asr-mtl",
            "qwen-audio-3.0-asr-flash-filetrans",
            "qwen3-asr-flash-filetrans",
            "paraformer-v1",
            "paraformer-mtl-v1"
          ],
          "items": {
            "enum": [
              "paraformer-v1",
              "paraformer-v2",
              "paraformer-mtl-v1",
              "fun-asr",
              "fun-asr-mtl",
              "qwen-audio-3.0-asr-flash-filetrans",
              "qwen3-asr-flash-filetrans"
            ],
            "type": "string"
          },
          "title": "Dashscope Fallback Models",
          "type": "array"
        },
        "dashscope_free_tier_confirmed_models": {
          "default": [],
          "items": {
            "enum": [
              "paraformer-v1",
              "paraformer-v2",
              "paraformer-mtl-v1",
              "fun-asr",
              "fun-asr-mtl",
              "qwen-audio-3.0-asr-flash-filetrans",
              "qwen3-asr-flash-filetrans"
            ],
            "type": "string"
          },
          "title": "Dashscope Free Tier Confirmed Models",
          "type": "array"
        },
        "dashscope_model": {
          "default": "paraformer-v2",
          "enum": [
            "paraformer-v1",
            "paraformer-v2",
            "paraformer-mtl-v1",
            "fun-asr",
            "fun-asr-mtl",
            "qwen-audio-3.0-asr-flash-filetrans",
            "qwen3-asr-flash-filetrans"
          ],
          "title": "Dashscope Model",
          "type": "string"
        },
        "local_whisper_model": {
          "default": "small",
          "enum": [
            "tiny",
            "base",
            "small"
          ],
          "title": "Local Whisper Model",
          "type": "string"
        },
        "provider_order": {
          "default": [
            "dashscope"
          ],
          "items": {
            "$ref": "#/$defs/AsrProvider"
          },
          "title": "Provider Order",
          "type": "array"
        },
        "siliconflow_models": {
          "default": [
            "FunAudioLLM/SenseVoiceSmall",
            "TeleAI/TeleSpeechASR"
          ],
          "items": {
            "type": "string"
          },
          "title": "Siliconflow Models",
          "type": "array"
        }
      },
      "title": "AsrConfig",
      "type": "object"
    },
    "AsrProvider": {
      "description": "Supported ASR providers in fallback order.",
      "enum": [
        "dashscope",
        "siliconflow",
        "local_whisper"
      ],
      "title": "AsrProvider",
      "type": "string"
    },
    "LimitConfig": {
      "additionalProperties": false,
      "description": "Per-run and time-window safety limits.",
      "properties": {
        "asr_minutes_per_day": {
          "default": 240,
          "minimum": 1,
          "title": "Asr Minutes Per Day",
          "type": "integer"
        },
        "asr_minutes_per_month": {
          "default": 3000,
          "minimum": 1,
          "title": "Asr Minutes Per Month",
          "type": "integer"
        },
        "episodes_per_run": {
          "default": 4,
          "minimum": 1,
          "title": "Episodes Per Run",
          "type": "integer"
        },
        "provider_poll_attempts": {
          "default": 60,
          "minimum": 1,
          "title": "Provider Poll Attempts",
          "type": "integer"
        }
      },
      "title": "LimitConfig",
      "type": "object"
    },
    "SummaryConfig": {
      "additionalProperties": false,
      "description": "Remote-first summary generation settings.",
      "properties": {
        "chunk_minutes": {
          "default": 30,
          "maximum": 120,
          "minimum": 5,
          "title": "Chunk Minutes",
          "type": "integer"
        },
        "chunk_tokens": {
          "default": 12000,
          "maximum": 100000,
          "minimum": 1000,
          "title": "Chunk Tokens",
          "type": "integer"
        },
        "dashscope_model": {
          "const": "qwen-flash",
          "default": "qwen-flash",
          "title": "Dashscope Model",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "local_qwen_fallback": {
          "default": true,
          "title": "Local Qwen Fallback",
          "type": "boolean"
        },
        "max_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 512,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "prompt_version": {
          "default": "summary-v1",
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "siliconflow_models": {
          "default": [
            "Qwen/Qwen3-8B"
          ],
          "items": {
            "type": "string"
          },
          "title": "Siliconflow Models",
          "type": "array"
        }
      },
      "title": "SummaryConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete secret-free application configuration.",
  "properties": {
    "asr": {
      "$ref": "#/$defs/AsrConfig"
    },
    "limits": {
      "$ref": "#/$defs/LimitConfig"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state_file": {
      "default": ".xyz2notion/state.json",
      "minLength": 1,
      "title": "State File",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/SummaryConfig"
    }
  },
  "title": "AppConfig",
  "type": "object"
}
