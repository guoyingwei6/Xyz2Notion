{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guoyingwei6/Xyz2Notion/blob/main/schemas/config.schema.json",
  "title": "Xyz2Notion configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["tingwu_cookie", "siliconflow", "dashscope_paid"]
          },
          "default": ["tingwu_cookie", "siliconflow"]
        },
        "paid_enabled": {
          "type": "boolean",
          "default": false
        },
        "paid_budget_cny": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "siliconflow_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "default": "qwen-flash"
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "default": "summary-v1"
        },
        "chunk_tokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000,
          "default": 24000
        },
        "chunk_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "default": 30
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768,
          "default": 8192
        },
        "input_cny_per_million_tokens": {
          "type": "number",
          "minimum": 0,
          "default": 0.15
        },
        "output_cny_per_million_tokens": {
          "type": "number",
          "minimum": 0,
          "default": 1.5
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episodes_per_run": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "asr_minutes_per_day": {
          "type": "integer",
          "minimum": 1,
          "default": 240
        },
        "asr_minutes_per_month": {
          "type": "integer",
          "minimum": 1,
          "default": 3000
        },
        "provider_poll_attempts": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        }
      }
    },
    "state_file": {
      "type": "string",
      "minLength": 1,
      "default": ".xyz2notion/state.json"
    }
  }
}
